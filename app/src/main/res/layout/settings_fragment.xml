<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="vertical" android:padding="16.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cursor_speed" />
                    <com.winlator.widget.SeekBar android:id="@+id/SBCursorSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" app:maxValue="200" app:minValue="10" app:suffix="%" />
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8.0dp">
                        <LinearLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cursor_size" />
                            <com.winlator.widget.SeekBar android:id="@+id/SBCursorSize" android:layout_width="match_parent" android:layout_height="wrap_content" app:maxValue="200" app:minValue="100" app:step="5" app:suffix="%" />
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8.0dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/color" />
                            <com.winlator.widget.ColorPickerView android:id="@+id/CPVCursorColor" android:layout_width="84.0dp" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                    <View style="@style/FieldSeparator" />
                    <CheckBox android:id="@+id/CBMoveCursorToTouchpoint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/move_cursor_to_touchpoint" />
                    <CheckBox android:id="@+id/CBCapturePointerOnExternalMouse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="@string/capture_pointer_on_external_mouse" />
                </LinearLayout>
                <TextView android:text="@string/mouse" style="@style/FieldSetLabel" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preferred_input_api" />
                    <Spinner android:entries="@array/preferred_input_api_entries" android:id="@+id/SPreferredInputApi" android:layout_width="match_parent" style="@style/ComboBox" />
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="8.0dp" android:text="@string/player" />
                        <LinearLayout style="@style/Toolbox">
                            <LinearLayout android:orientation="horizontal" android:id="@+id/LLGamepadPlayer" android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <ImageView android:layout_width="40.0dp" android:layout_height="40.0dp" android:src="@drawable/gamepad_player_1" style="@style/ListMenuButton" />
                                <ImageView android:layout_width="40.0dp" android:layout_height="40.0dp" android:src="@drawable/gamepad_player_2" style="@style/ListMenuButton" />
                                <ImageView android:layout_width="40.0dp" android:layout_height="40.0dp" android:src="@drawable/gamepad_player_3" style="@style/ListMenuButton" />
                                <ImageView android:layout_width="40.0dp" android:layout_height="40.0dp" android:src="@drawable/gamepad_player_4" style="@style/ListMenuButton" />
                            </LinearLayout>
                            <View style="@style/VerticalLine" />
                            <ImageView android:id="@+id/BTResetGamepadPlayerConfigs" android:layout_width="40.0dp" android:layout_height="40.0dp" android:src="@drawable/icon_reset" style="@style/ListMenuButton" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:text="@string/game_controllers" style="@style/FieldSetLabel" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/midi_input_device" />
                    <Spinner android:id="@+id/SMIDIInputDevice" android:layout_width="match_parent" style="@style/ComboBox" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/midi_soundfont" />
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <Spinner android:id="@+id/SSoundFont" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" style="@style/ComboBox" />
                        <LinearLayout android:id="@+id/SoundFontToolbox" style="@style/Toolbox">
                            <ImageButton android:id="@+id/BTSoundFontTest" android:src="@drawable/icon_piano" style="@style/ListMenuButton" />
                            <ImageButton android:tag="install" android:src="@drawable/icon_install" style="@style/ListMenuButton" />
                            <ImageButton android:tag="remove" android:layout_marginRight="0.0dp" android:src="@drawable/icon_remove" style="@style/ListMenuButton" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:text="@string/sound" style="@style/FieldSetLabel" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/language" />
                    <Spinner android:entries="@array/language_entries" android:id="@+id/SLanguage" android:layout_width="match_parent" style="@style/ComboBox" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme" />
                    <RadioGroup android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/RGAppTheme" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <RadioButton android:id="@+id/RBLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/light" />
                        <RadioButton android:id="@+id/RBDark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dark" />
                    </RadioGroup>
                    <CheckBox android:id="@+id/CBOpenAndroidBrowserFromWine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="@string/open_android_browser_from_wine" />
                    <CheckBox android:id="@+id/CBUseAndroidClipboardOnWine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="@string/use_android_clipboard_on_Wine" />
                </LinearLayout>
                <TextView android:text="@string/system" style="@style/FieldSetLabel" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/box64_version" />
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <Spinner android:id="@+id/SBox64Version" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" style="@style/ComboBox" />
                        <LinearLayout android:id="@+id/Box64Toolbox" style="@style/Toolbox">
                            <ImageButton android:tag="install" android:src="@drawable/icon_install" style="@style/ListMenuButton" />
                            <ImageButton android:tag="remove" android:layout_marginRight="0.0dp" android:src="@drawable/icon_remove" style="@style/ListMenuButton" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/box64_preset" />
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <Spinner android:id="@+id/SBox64Preset" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" style="@style/ComboBox" />
                        <LinearLayout style="@style/Toolbox">
                            <ImageButton android:id="@+id/BTAddBox64Preset" android:src="@drawable/icon_add" style="@style/ListMenuButton" />
                            <ImageButton android:id="@+id/BTEditBox64Preset" android:src="@drawable/icon_edit" style="@style/ListMenuButton" />
                            <ImageButton android:id="@+id/BTDuplicateBox64Preset" android:src="@drawable/icon_duplicate" style="@style/ListMenuButton" />
                            <ImageButton android:id="@+id/BTRemoveBox64Preset" android:layout_marginRight="0.0dp" android:src="@drawable/icon_remove" style="@style/ListMenuButton" />
                        </LinearLayout>
                    </LinearLayout>
                    <View style="@style/FieldSeparator" />
                    <CheckBox android:id="@+id/CBEnableWineDebug" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/enable_wine_debug" />
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:orientation="horizontal" android:id="@+id/LLWineDebugChannels" android:padding="4.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </HorizontalScrollView>
                    <View style="@style/FieldSeparator" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/box64_logs" />
                    <Spinner android:entries="@array/box64_logs" android:id="@+id/SBox64Logs" android:layout_width="match_parent" style="@style/ComboBox" />
                    <CheckBox android:id="@+id/CBSaveLogsToFile" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8.0dp" android:text="@string/save_logs_to_file" />
                    <EditText android:id="@+id/ETLogFile" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" style="@style/EditText" />
                    <LinearLayout android:orientation="vertical" android:id="@+id/LLWineInstallation" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <View style="@style/FieldSeparator" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wine_version" />
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <Spinner android:id="@+id/SWineVersion" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" style="@style/ComboBox" />
                            <LinearLayout style="@style/Toolbox">
                                <ImageButton android:id="@+id/BTInstallWine" android:src="@drawable/icon_install" style="@style/ListMenuButton" />
                                <ImageButton android:id="@+id/BTRemoveWine" android:layout_marginRight="0.0dp" android:src="@drawable/icon_remove" style="@style/ListMenuButton" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <View style="@style/FieldSeparator" />
                    <LinearLayout android:gravity="center_horizontal" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <Button android:layout_gravity="center_horizontal" android:id="@+id/BTReinstallSystemFiles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reinstall_system_files" style="@style/ButtonNeutral" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:text="@string/advanced" style="@style/FieldSetLabel" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_gravity="right|bottom" android:id="@+id/BTConfirm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="16.0dp" android:src="@drawable/icon_confirm" android:tint="#ffffff" />
</FrameLayout>
