<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:orientation="vertical" android:layout_width="300.0dp" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/performance_mode" />
        <Spinner android:entries="@array/audio_performance_mode_entries" android:id="@+id/SPerformanceMode" android:layout_width="match_parent" style="@style/ComboBox" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/volume" />
        <com.winlator.widget.SeekBar android:id="@+id/SBVolume" android:layout_width="match_parent" android:layout_height="wrap_content" app:maxValue="100" app:minValue="0" app:suffix="%" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/average_latency" />
        <com.winlator.widget.SeekBar android:id="@+id/SBLatencyMillis" android:layout_width="match_parent" android:layout_height="wrap_content" app:maxValue="120" app:minValue="12" app:step="2" app:suffix=" ms" />
    </LinearLayout>
</LinearLayout>
